# Inference for the sandbox agent; registered with OpenShell by NemoClaw.
NVIDIA_INFERENCE_API_KEY=<nvidia-endpoints-api-key>
# Inference for the host-side worker; stored in its Docker environment.
OPENAI_API_KEY=<nvidia-endpoints-api-key>
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
DEEPAGENTS_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional existing helper services. Empty disables that tool.
WEBSEARCH_ENDPOINT_URL=
WEBSEARCH_SERVICE_SECRET=
DOC_SEARCH_ENDPOINT_URL=
DOC_SEARCH_SERVICE_SECRET=
