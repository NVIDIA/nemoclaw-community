{
  "name": "axe-a11y-mcp-server",
  "version": "1.2.0",
  "description": "MCP server for web accessibility testing, screenshots, recordings, PDFs, and network capture using axe-core and Patchright",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_ENV=test node --test test.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.0",
    "ipaddr.js": "^2.5.0",
    "patchright": "^1.61.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
