FROM node:22-slim

# System deps: tools for adding Google's apt repo, Chrome runtime libs, VNC/X11 stack
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    xvfb \
    x11vnc \
    fluxbox \
    procps \
 && install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

# Patchright uses the system-installed Chrome via channel:'chrome' — no browser download step needed.

COPY . .

# Make server executable
RUN chmod +x server.js

RUN groupadd -r pptruser && useradd -r -g pptruser -G audio,video pptruser \
    && mkdir -p /home/pptruser \
    && chown -R pptruser:pptruser /home/pptruser \
    && chown -R pptruser:pptruser /app

ENV PORT=9010
ENV DISPLAY=:99
ENV PLAYWRIGHT_HEADLESS=false

# Expose HTTP API and VNC
EXPOSE 9010 5900

# Start script that launches Xvfb, VNC, and the server
COPY start.sh /start.sh
RUN chmod +x /start.sh

USER pptruser

CMD ["/start.sh"]
