#
# Copy to .env and edit. Never commit .env. Every value here has a default, so
# the scripts also run without a .env file.

# Dedicated sandbox that setup creates and teardown deletes. OpenShell 0.1
# limits sandbox names to 19 characters.
SANDBOX_NAME=local-only-assist

# Host folder that setup copies into /sandbox/workspace. The sandbox receives
# a copy. The host folder is never mounted.
WORKSPACE_DIR=./fixtures/workspace
WORKSPACE_MAX_FILE_BYTES=1048576

# Ollama model that the recipe-owned server downloads and serves. The default
# is NVIDIA Nemotron 3 Nano 4B, a download of about 2.8 GB.
INFERENCE_MODEL=nemotron-3-nano:4b-q4_K_M
INFERENCE_PROVIDER_NAME=local-only-ollama

# Address and port where Docker publishes the Ollama server. Setup rejects an
# address that publishes the port on every interface.
OLLAMA_PUBLISH_HOST=127.0.0.1
OLLAMA_PORT=11434

# URL that processes inside the sandbox call for inference.
# host.openshell.internal is the OpenShell name for the gateway host. Setup
# rejects a URL that does not point at this machine, and a URL whose host and
# port differ from the endpoint in policies/ollama-provider-profile.yaml.
INFERENCE_BASE_URL=http://host.openshell.internal:11434/v1

# Local image that setup builds from the Dockerfile and teardown deletes.
SANDBOX_IMAGE=local-only-workspace-assistant:local

# Optional comma-separated hosts to accept as local in INFERENCE_BASE_URL,
# such as the address of a Docker bridge on this machine.
LOCAL_ENDPOINT_EXTRA_HOSTS=

# Where the model runs: auto, gpu, or cpu. With auto, setup uses the NVIDIA GPU
# when 'nvidia-smi -L' finds one and the CPU otherwise. With gpu, setup stops
# when it finds no GPU. The sandbox boundary tests do not need a GPU.
INFERENCE_DEVICE=auto

# Set to 1 to continue when the kernel does not list the Landlock security
# module. The filesystem cases of the test suite are then expected to fail.
ALLOW_MISSING_LANDLOCK=0
