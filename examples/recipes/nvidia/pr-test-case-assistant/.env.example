# Sandbox identity.
NEMOCLAW_SANDBOX_NAME=pr-test-case-assistant

# Default inference provider.
NEMOCLAW_PROVIDER=build
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_INFERENCE_API_KEY=

# Slack Socket Mode. Create the app from config/slack-app-manifest.yml, which is
# direct-message-only and reads no channel.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Recommended for shared workspaces. Comma-separate multiple Slack member IDs.
SLACK_ALLOWED_USERS=

# Optional, and only meaningful if you installed config/slack-app-manifest-channels.yml. Bounds
# which channels the runtime acts on; it does not narrow the scopes Slack granted.
SLACK_ALLOWED_CHANNELS=
