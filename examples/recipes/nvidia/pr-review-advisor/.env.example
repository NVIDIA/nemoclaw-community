# Copy to the installation root as .env with mode 0600. This file is parsed as
# data, never sourced: use exact KEY=value assignments without shell syntax.

# Managed NVIDIA is the default provider mode.
REVIEW_ADVISOR_PROVIDER_MODE=nvidia
NVIDIA_INFERENCE_API_KEY=
NEMOCLAW_ENDPOINT_URL=https://integrate.api.nvidia.com/v1
NEMOCLAW_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenAI-compatible mode instead requires all three fields below. Remove the
# NVIDIA credential and replace the mode, endpoint, and model above.
# REVIEW_ADVISOR_PROVIDER_MODE=openai-compatible
# COMPATIBLE_API_KEY=
# NEMOCLAW_ENDPOINT_URL=https://inference.example.com/v1
# NEMOCLAW_MODEL=provider/model

# Existing-provider mode never creates or updates provider credentials.
# REVIEW_ADVISOR_PROVIDER_MODE=existing
# INFERENCE_PROVIDER_NAME=preprovisioned-provider
# Reviewed v0.1 types are nvidia, openai, and deepinfra.
# REVIEW_ADVISOR_EXISTING_PROVIDER_TYPE=nvidia
# NEMOCLAW_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# The gateway endpoint is required and must be a dedicated HTTPS loopback
# origin with an explicit port. Provision it through the trusted NemoClaw /
# OpenShell host workflow before running bring-up.sh.
OPENSHELL_GATEWAY_ENDPOINT=

# Names and the Hermes forward port default to install-derived unique values.
# Override them only when the replacements remain dedicated to this install.
# OPENSHELL_GATEWAY=
# NEMOCLAW_SANDBOX_NAME=
# INFERENCE_PROVIDER_NAME=
# HERMES_FORWARD_PORT=

# Private lifecycle state defaults to XDG_STATE_HOME (or $HOME/.local/state),
# outside the repository checkout, with an install-identity subdirectory.
# REVIEW_ADVISOR_STATE_ROOT=/absolute/private/state/root

# Trusted input limits. A review fails closed instead of silently truncating.
REVIEW_ADVISOR_MAX_FILES=512
REVIEW_ADVISOR_MAX_CONTEXT_BYTES=33554432
REVIEW_ADVISOR_MAX_CHECKOUT_FILES=50000
REVIEW_ADVISOR_MAX_CHECKOUT_BYTES=536870912
