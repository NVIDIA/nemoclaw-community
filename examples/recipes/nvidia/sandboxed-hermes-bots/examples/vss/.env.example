# Copy to .env next to compose.yml. .env is gitignored.

# NGC API key (nvapi-...). RT-VLM downloads its model weights from NGC on
# first start. Prefer passing it from a mode-600 file at `up` time rather than
# writing it here:
#   NGC_API_KEY=$(cat ~/.secrets/ngc.key) docker compose up -d
# `docker compose down` does not need it.
NGC_API_KEY=

# Container image. Pinned by digest to the tested build; see compose.yml.
# Uncomment and change to try another build.
#VSS_RT_VLM_IMAGE=ghcr.io/nvidia-ai-blueprints/vss/vss-rt-vlm@sha256:...

# Which GPU. An index from nvidia-smi, or a GPU/MIG UUID.
VSS_GPU=1

# Where to listen. The OpenShell bridge, so only sandboxes can reach it.
# Linux: 172.18.0.1. macOS/Colima: what `./swarm doctor` prints as the bridge.
VSS_BIND=172.18.0.1
VSS_PORT=8018

# Fraction of the GPU's memory vLLM may take. 0.5 of a B200 is plenty for an
# 8B VLM; raise it on smaller cards, or lower it to share the GPU.
VSS_GPU_MEM=0.5
