{
  "manifest_version": 3,
  "name": "Ask NemoClaw",
  "description": "Ask a NemoClaw agent about the current browser page.",
  "version": "0.10.11",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "cookies"],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ask NemoClaw about this page"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
