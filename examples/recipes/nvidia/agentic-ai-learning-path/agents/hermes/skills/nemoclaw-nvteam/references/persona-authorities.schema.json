{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nemoclaw:nvteam:persona-authorities:schema:1",
  "title": "NemoClaw NVTeam persona authority registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_kind",
    "people",
    "assignments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "registry_kind": {
      "const": "base"
    },
    "people": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/person"
      }
    },
    "assignments": {
      "type": "object",
      "description": "Persona-scoped authority assignments. Only assignments with enabled set to true can affect authority weighting.",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/assignment"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_names",
        "nvidia_logins",
        "emails",
        "slack_user_ids",
        "github_logins"
      ],
      "properties": {
        "display_names": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "nvidia_logins": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "emails": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "slack_user_ids": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "github_logins": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "role_snapshot",
        "designation_basis",
        "verified_on",
        "review_after_days",
        "identities"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role_snapshot": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "designation_basis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verified_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_after_days": {
          "type": "integer",
          "minimum": 1
        },
        "identities": {
          "$ref": "#/$defs/identities"
        }
      }
    },
    "persona": {
      "enum": [
        "akira",
        "alex",
        "jordan",
        "morgan",
        "parker",
        "quinn",
        "river",
        "robin"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "topics",
        "claim_types"
      ],
      "properties": {
        "products": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "topics": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "claim_types": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "persona",
        "level",
        "enabled",
        "scope",
        "rationale"
      ],
      "properties": {
        "person_id": {
          "$ref": "#/$defs/stableId"
        },
        "persona": {
          "$ref": "#/$defs/persona"
        },
        "level": {
          "enum": [
            "primary",
            "supporting"
          ]
        },
        "enabled": {
          "type": "boolean",
          "description": "When false, exclude this assignment from authority weighting, identity priority, routing, and search behavior."
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
