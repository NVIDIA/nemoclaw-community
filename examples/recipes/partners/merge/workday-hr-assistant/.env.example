# Merge Workday HR assistant recipe — copy to .env and fill in. Never commit .env.
#
# The runtime key is read by scripts/onboard.sh ONLY to register the OpenShell
# provider on the host. It is never exported into the sandbox: the agent
# references the placeholder `openshell:resolve:env:MERGE_AH_MCP_TOKEN`, which
# OpenShell resolves at egress.
#
# Issue a RUNTIME-ONLY key restricted to the Tool Pack and Registered User
# below, with an expiry. It needs the runtime scope only. A key carrying
# management scope can create itself a wider Tool Pack, which defeats the
# boundary this example demonstrates; verify.sh case 6 fails on such a key.
#
# The dashboard does not offer per-Tool-Pack or per-Registered-User scoping, so a
# key created there reaches every pack and user and fails verify.sh case 7. Issue
# this key on the API instead: `bash scripts/issue-runtime-key.sh` creates one
# bound to the two identifiers below and records it here. The value is returned
# once, at creation; a lost value cannot be read back and the key must be replaced.
# https://docs.merge.dev/merge-agent-handler/secure/scoping-access-per-user
MERGE_AH_MCP_TOKEN=

# The hr-reader Tool Pack, created by scripts/setup-packs.sh. It must contain
# only the six read tools. A pack carrying the full 60-tool Workday connector
# does not demonstrate the role boundary this example is about.
MERGE_AH_TOOL_PACK_ID=

# The Registered User whose linked Workday authorization the reads run under.
MERGE_AH_REGISTERED_USER_ID=

# Setup and key issuance prompt for the management key with input hidden.
# Do not store the management key in this file.

# Optional overrides:
# MERGE_AH_KEY_TTL_SECONDS=3600            # runtime-key lifetime at creation, positive seconds
# NEMOCLAW_SANDBOX_NAME=merge-hr          # existing sandbox; this recipe does not create one
# MCP_SERVER_NAME=merge-workday           # registration name inside the sandbox
# AH_BASE_URL=https://ah-api.merge.dev
# SYSTEM_NAME=Workday
# READER_TOOL=workday__list_workers               # the tool the reader role must have
# EXCLUDED_TOOL=workday__request_one_time_payment # the tool the reader role must NOT have
# OTHER_TOOL_PACK_ID=                     # another existing pack this key is NOT bound to; required for case 7
# EXPECT_REVOKED=1                        # assert refusal after revoking the key
