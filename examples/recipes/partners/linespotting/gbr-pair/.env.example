# Copy to .env on the host. Do not commit .env.
# Do not put mailbox keys, X-GBR-Key, or device.json in this file.

SANDBOX_NAME=gbr-pair

# Leave at 0 when the OpenShell skill must GET the host Bot API.
# The sandbox has no mailbox key. Set 1 only for host-only Bot API use
# with no sandbox attach.
# GBR_BOT_REQUIRE_KEY=0
