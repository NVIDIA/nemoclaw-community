{
  "name": "shrike-security-openclaw-plugin",
  "version": "0.1.0",
  "description": "Shrike action-governance OpenClaw plugin: a before_tool_call hook that evaluates every tool call against Shrike's enforce plane (in-sandbox defense-in-depth).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.22",
      "minGatewayVersion": "2026.5.22"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
