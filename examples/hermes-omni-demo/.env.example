# Local settings for the Hermes + Omni demo.
#
# This demo configures an existing Hermes sandbox created by:
#   nemohermes onboard

SANDBOX=my-hermes
HERMES_CLI=nemohermes

# Host UI/server. start.sh serves the React UI and FastAPI API on one port.
PORT=8765
HOST=0.0.0.0
UPLOAD_DIR=/tmp/omni-demo-uploads

# Omni model used by the sandbox workspace script. The OpenShell gateway route
# must also point to this model; see README.md.
OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional Phoenix host service. Start it with:
#   bash scripts/00-host-services.sh
#
# Existing NemoFlow-enabled Hermes images can export traces here. Standard
# onboarded Hermes images may not emit traces unless they include NemoFlow.
# NEMO_FLOW_PROJECT_NAME=hermes-omni-demo
# PHOENIX_COLLECTOR_ENDPOINT=http://172.17.0.1:6006/v1/traces
