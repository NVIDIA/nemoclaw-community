# Copy to .env and fill in real values, then run:
#   bash scripts/bring-up.sh
#
# Optional telemetry:
#   bash scripts/00-host-services.sh   # starts Phoenix only

# ── Inference (the agent's LLM) ──────────────────────────────────────────
# Required. COMPATIBLE_API_KEY is preferred; OPENAI_API_KEY is also accepted.
# For the default NemoClaw endpoint, get a key from https://build.nvidia.com.
COMPATIBLE_API_KEY=
NEMOCLAW_ENDPOINT_URL=https://integrate.api.nvidia.com/v1
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# Corporate VPN / split-horizon DNS / local-CA hosts: if the sandbox can't
# validate the inference endpoint's TLS chain, run scripts/host-tls-proxy.py
# on the host and point at it instead — see docs/host-tls-proxy.md.
# NEMOCLAW_ENDPOINT_URL=http://172.17.0.1:18080/v1

# ── Slack (required interaction channel) ─────────────────────────────────
# See docs/set-up-slack.md. Both tokens are required.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Comma-separated Slack user IDs allowed to DM or mention the agent.
# Leave empty only for local experiments where any workspace user may interact.
SLACK_ALLOWED_IDS=

# ── Tavily (required web/forum search) ───────────────────────────────────
# Used by the tavily-web-search skill for live web and NVIDIA forum research.
TAVILY_API_KEY=

# ── GitHub (required live GitHub search) ─────────────────────────────────
# Used by the github-cli-search skill through gh.
GITHUB_TOKEN=

# ── Optional: observability ──────────────────────────────────────────────
# Start Phoenix first with: bash scripts/00-host-services.sh
# Then set this before bring-up to enable NeMo-Flow/OpenInference telemetry.
# PHOENIX_COLLECTOR_ENDPOINT=http://172.17.0.1:6006/v1/traces

# ── Optional: bring-up overrides ─────────────────────────────────────────
# SANDBOX_NAME=hermes-direct
# OPENSHELL_GATEWAY=examples-gateway
# OPENSHELL_GATEWAY_PORT=8090
