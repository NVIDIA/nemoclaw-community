#
# Copy to .env and fill in. The .env file is git-ignored.
# Every variable this example reads is listed here. None carries a value.

# === Models (required by the analyst and the optimizer) ===
# Workspace-qualified names, as printed by: nemo models list --all-pages
NEMO_DEFAULT_MODEL=default/<your-model>
NEMO_FAST_MODEL=default/<your-fast-model>

# === Platform ===
NMP_BASE_URL=http://localhost:8080
NMP_WORKSPACE=default

# The gateway caps any single response at 300 seconds and returns 502 while the
# agent keeps working. Raise it for CAD reconstructions, which routinely exceed it.
NEMO_AGENTS_GATEWAY_READ_TIMEOUT=1800

# === FreeCAD ===
# The MCP addon's XML-RPC endpoint inside the running GUI.
FREECAD_RPC=http://127.0.0.1:9875

# Absolute path to the FreeCAD binary used for headless scoring. Unset falls back
# to the macOS app bundle, then freecadcmd / FreeCADCmd on PATH.
FREECAD_BIN=

# === Harness (read by harness/agent_source/harbor_wrapper.py) ===
# The deployment every optimizer trial invokes, and the agent name its traces
# are correlated by. See the KNOWN LIMITATION in harbor_wrapper.py before
# changing the deployment.
CAD_AGENT_DEPLOYMENT=cad-agent-deployment
CAD_AGENT_NAME=cad-agent

# Absolute path to the scorer. Defaults to scorer/score.py in this checkout.
CAD_SCORER=

# Seconds to wait for one agent invocation, and for its trace to reach Intake.
# Ingestion is asynchronous, so the trace wait is not the same as the run wait.
CAD_AGENT_TIMEOUT=3600
CAD_AGENT_TRACE_WAIT=3600
