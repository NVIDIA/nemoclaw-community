# Actor: full OpenAI-compatible Chat Completions URL; key stays on the host.
ACTOR_URL=https://integrate.api.nvidia.com/v1/chat/completions
ACTOR_MODEL=<actor-model-id>
ACTOR_API_KEY=<actor-api-key>
# Decision service: full URL implementing the request/response contract in README.md.
# A public hosted decision endpoint is not yet available for this example.
DECISION_URL=https://decision.example.com/v1/decide
DECISION_MODEL=<decision-model-id>
DECISION_API_KEY=<decision-api-key>
