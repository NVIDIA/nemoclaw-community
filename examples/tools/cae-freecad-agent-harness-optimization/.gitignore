# Credentials
.env

# FreeCAD documents and their backups, except the eval suite's reference solutions
# and the negative controls.
*.FCStd
*.FCStd[0-9]
*.FCBak
!evals/*/solution/*.FCStd
!controls/*/*.FCStd

# Python
__pycache__/
*.py[cod]
.venv/
.venv-checks/

.DS_Store

# Compass findings written locally
insights.yml
analyst.local.yaml

# Eval Author's private task workspaces, and the skills installed into a coding
# agent. This example's own skill is tracked under skills/.
.eval-author/
.claude/
.agents/
.cursor/
.pi/
skills-lock.json

# The experiment workspace (candidate agents, eval runs, reports) stays local.
# results/ holds the measured outcome and the final agent.
experiments/

# Harbor jobs from the commands in evals/README.md
runs/
