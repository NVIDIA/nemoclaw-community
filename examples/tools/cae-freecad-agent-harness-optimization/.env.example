# Copy to .env (git-ignored); NeMo Compass loads it from this folder.
# Use a tool-calling, structured-output model. Through Helix's gateway the model is
# openai/<model entity from `nemo models list`>, or point at your provider directly.
COMPASS_MODEL=openai/REPLACE_WITH_YOUR_MODEL_NAME
COMPASS_API_BASE=http://localhost:8080/apis/inference-gateway/v2/workspaces/default/openai/-/v1
COMPASS_API_KEY=
