{
  "name": "naive_rag",
  "description": "Embedding retrieval over raw chunks; no ingest-time reasoning.",
  "model": "gpt-4o",
  "ingest": [
    "python3",
    "adapters/naive_rag/run.py",
    "ingest",
    "--corpus",
    "{corpus}",
    "--state",
    "{state}"
  ],
  "answer": [
    "python3",
    "adapters/naive_rag/run.py",
    "answer",
    "--state",
    "{state}"
  ]
}
