# Pinned local Phoenix configuration for the conference trace example.
PHOENIX_IMAGE=arizephoenix/phoenix:19.10.0@sha256:3092f5543a3ddd35db7390cf971027c33be6be1f171274d57f3c8658c2193d67
PHOENIX_UI_PORT="${PHOENIX_UI_PORT:-6006}"
PHOENIX_CONTAINER_NAME="${PHOENIX_CONTAINER_NAME:-nemoclaw-hermes-relay-tracing-phoenix-$PHOENIX_UI_PORT}"
PHOENIX_UI_URL="http://127.0.0.1:$PHOENIX_UI_PORT"
PHOENIX_OTLP_ENDPOINT="$PHOENIX_UI_URL/v1/traces"
PHOENIX_PROJECT_PREFIX=hermes-relay-tracing
