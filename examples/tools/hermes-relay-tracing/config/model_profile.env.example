# Copy this file to model-profile.env, which is ignored by Git, and replace
# each placeholder with values supplied by your model provider.
MODEL_PROFILE_NAME=comparison
MODEL_PROFILE_MODEL=provider/model-name
MODEL_PROFILE_BASE_URL=https://provider.example.com/v1
# Supported values: chat_completions, anthropic_messages, codex_responses.
MODEL_PROFILE_API_MODE=chat_completions
# Store this variable in keys.env. Do not put its value in this profile.
MODEL_PROFILE_API_KEY_ENV=COMPARISON_API_KEY
