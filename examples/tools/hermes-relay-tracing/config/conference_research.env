# Conference research example. The fixed travel plan and expected
# answer make task success mechanically verifiable while leaving the research
# path to the agent. The default model comes from smoke.env so both examples
# use the same NVIDIA Build configuration.
CONFERENCE_RESEARCH_MAX_TURNS=12
CONFERENCE_RESEARCH_RUN_BUDGET_SECONDS=300
CONFERENCE_RESEARCH_EXPECTED_NAME='COLT 2026'
CONFERENCE_RESEARCH_EXPECTED_SOURCE_PREFIX='https://learningtheory.org/colt2026'
CONFERENCE_RESEARCH_QUERY='Complete every step before answering. Read the travel plan in /input/travel-plan.md. Search the web for the one conference that satisfies every constraint, then open its official website to confirm the dates and location. Write the conference name, dates, location, and official source URL to /output/conference-verification.md. Do not narrate progress. After the file has been written successfully, reply with only the conference name.'
