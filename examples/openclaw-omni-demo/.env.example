# Local settings for the OpenClaw + Omni sub-agent demo.
#
# This demo configures an existing OpenClaw sandbox created by:
#   nemoclaw onboard

SANDBOX=hclaw
DOCKER_CTR=openshell-cluster-nemoclaw

# Required only when applying or refreshing the Omni provider config.
# Do not commit a filled .env file.
NVIDIA_API_KEY=

SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Useful for scripted tests because it bypasses the first-run identity prompt.
SEED_DEMO_IDENTITY=1

# Optional Phoenix host service. OpenClaw trace emission is runtime-dependent;
# Phoenix is included here as a standard observability target.
# NEMO_FLOW_PROJECT_NAME=openclaw-omni-demo
# PHOENIX_COLLECTOR_ENDPOINT=http://172.17.0.1:6006/v1/traces
