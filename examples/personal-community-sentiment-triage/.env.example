# Copy to .env and fill in real values, then:
#   set -a && source .env && set +a
#   bash scripts/00-host-services.sh   # host stack: phoenix, postgres, ETLs, postgrest
#   bash scripts/bring-up.sh           # OpenShell gateway, v2 providers, sandbox
#
# bring-up.sh auto-sources .env when key vars are unset, so you can also
# just run the two scripts directly after `cp .env.example .env`.
#
# Provider v2 prerequisite: `providers_v2_enabled` must be set at gateway-global scope.
#   openshell settings set --global --key providers_v2_enabled --value true --yes
# scripts/02-providers.sh checks this and refuses to run if unset.

# ── Inference (the agent's LLM) ──────────────────────────────────────────
# At least one API key is required for the agent to call any LLM. If both
# are unset, bring-up.sh skips the inference provider and warns.
# COMPATIBLE_API_KEY is preferred; OPENAI_API_KEY is also accepted.
#
# For the default NemoClaw endpoint, get a key from https://build.nvidia.com:
# sign in, open any model page, and click "Get API Key". The key may start
# with `nvapi-` or `sk-` depending on the backend.
COMPATIBLE_API_KEY=
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Optional override: the upstream inference endpoint. Default
# https://integrate.api.nvidia.com/v1 (built-in `nvidia` profile + the
# script-side fallback in 02-providers.sh). Uncomment + edit only for
# non-default targets:
#   - Corporate VPN / split-horizon DNS / local-CA hosts: run
#     scripts/host-tls-proxy.py on the host and point at it. See
#     docs/host-tls-proxy.md.
#   - Local vLLM, alternative NIM endpoint, etc.: any OpenAI-compatible URL.
# Threaded into the provider record as NVIDIA_BASE_URL (provider config).
# NEMOCLAW_ENDPOINT_URL=http://host.openshell.internal:18080/v1

# ── Outlook (optional — recommended primary channel) ─────────────────────
# Outlook is opt-in: fill ALL FOUR OUTLOOK_* vars below to enable, or leave
# the entire block empty for a Slack-only setup. Partial configuration is
# rejected at bring-up. At least one of Outlook or Slack must be configured.
#
# Tenant + client IDs come from your Azure app registration. The first
# bring-up runs an interactive Microsoft device-code login (see
# docs/set-up-outlook-bridge.md) and caches the resulting refresh token at
# .bootstrap/cache/ms-graph-token.json. Set OUTLOOK_FORCE_LOGIN=1 to redo.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=

# Mailbox the agent reads/sends from, and the From: address it uses on replies.
# Example values: agent@yourcompany.com / you@yourcompany.com
OUTLOOK_TARGET_MAILBOX=
OUTLOOK_REPLY_TO=

# Optional: comma-separated allowlist of senders the agent will respond to.
# Leave empty to accept any sender.
OUTLOOK_ALLOWED_SENDERS=

# ── Slack (required for the cross-platform showcase) ─────────────────────
# Both tokens are needed to enable the Slack channel. This example
# demonstrates cross-platform research across Slack, GitHub, NVIDIA forums,
# and Outlook — the slack-channel-finder and slack-channel-summarizer skills
# both need these tokens to read channel history and resolve references.
# SLACK_ALLOWED_IDS is an optional allowlist gating who can DM the agent
# (comma-separated Slack user IDs, e.g. UR0A4QL5N). Leave empty to allow
# anyone in the workspace to message the bot.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_IDS=

# ── GitHub (live read-only REST) ─────────────────────────────────────────
# The sandbox uses this token through an OpenShell provider placeholder for
# live GitHub REST reads. The raw token is resolved by the proxy on egress,
# and policy.yaml constrains usage to read-only api.github.com routes for
# GITHUB_READONLY_REPO. If you also keep the host-side GitHub mirror enabled,
# GITHUB_TOKEN gives that ETL practical API rate limits.
GITHUB_TOKEN=
# Optional fallback for the live sandbox provider if GITHUB_TOKEN is empty.
# Prefer GITHUB_TOKEN when you also want the host GitHub mirror authenticated.
GH_TOKEN=

# Live sandbox GitHub read-only scope. Change this to owner/repo to choose the
# one GitHub repo the sandbox can read. Recreate the sandbox after changing it:
# bash scripts/tear-down.sh && bash scripts/bring-up.sh
# scripts/03-sandbox.sh stages both policy.yaml and the Dockerfile before
# creation, so editing .env does not update an already-running sandbox.
GITHUB_READONLY_REPO=NVIDIA/OpenShell

# Optional host-side GitHub mirror repo for source-etls. This controls mirrored
# discussions/history in Postgres only; it does not change live sandbox access.
# SOURCE_ETL_GITHUB_REPO=NVIDIA/NemoClaw

# ── Optional: Telegram / Discord ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# DISCORD_BOT_TOKEN=

# ── Optional: Phoenix OpenInference egress ───────────────────────────────
# NeMo-Relay is installed unconditionally by the Dockerfile, so the agent
# always writes ATIF (Agent Trajectory Format) traces to /tmp/atif/ inside
# the sandbox. Pull them off with `bash scripts/download-traces.sh` — no
# collector or extra config required.
#
# Set PHOENIX_COLLECTOR_ENDPOINT below to additionally stream OpenInference
# traces to a Phoenix collector for live inspection. The 00-host-services.sh
# stack already starts Phoenix on host port 6006; the URL below points the
# sandbox at it through the OpenShell host bridge.
# PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces

# Phoenix project name. Sets openinference.project.name on every exported
# span so Phoenix routes traces to a named project (vs. falling back to
# service.name). Defaults to "default" if unset; override to keep multiple
# deployments separate in the same Phoenix instance.
# PHOENIX_PROJECT_NAME=personal-community-sentiment-triage

# ── Optional: bring-up overrides ─────────────────────────────────────────
# SANDBOX_NAME=hermes-direct
# Default package-managed OpenShell installs expose a local mTLS gateway at
# https://127.0.0.1:17670 under the name `openshell`.
# OPENSHELL_GATEWAY=openshell
#
# Snap installs expose a plaintext local gateway at http://127.0.0.1:17670.
# Uncomment both lines below when following deploy/snap/README.md:
# OPENSHELL_GATEWAY=snap-docker
# OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:17670
#
# SOURCE_ETL_API_HOST=host.openshell.internal
# SOURCE_ETL_API_PORT=3100
