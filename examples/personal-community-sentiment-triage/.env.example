# Copy to .env and fill in real values, then:
#   bash scripts/00-host-services.sh   # phoenix, postgres, ETLs, postgrest (+ minio + relay when ATIF_STORAGE_BACKEND=minio)
#   bash scripts/bring-up.sh           # OpenShell gateway, v2 providers, sandbox
#
# Both scripts auto-source .env, so `cp .env.example .env` and run is enough.
# Prereq: `openshell settings set --global --key providers_v2_enabled --value true --yes` (02-providers.sh enforces this and prints the command if missing).

# ── Inference (the agent's LLM) ──────────────────────────────────────────
# At least one API key is required for the agent to call any LLM. If both
# are unset, bring-up.sh skips the inference provider and warns.
# COMPATIBLE_API_KEY is preferred; OPENAI_API_KEY is also accepted.
#
# For the default NemoClaw endpoint, get a key from https://build.nvidia.com:
# sign in, open any model page, and click "Get API Key". The key may start
# with `nvapi-` or `sk-` depending on the backend.
COMPATIBLE_API_KEY=
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Optional override for the inference endpoint (default
# https://integrate.api.nvidia.com/v1). Any OpenAI-compatible URL works
# — local vLLM, alternative NIM, or scripts/host-tls-proxy.py for
# corporate VPNs (see docs/host-tls-proxy.md).
# NEMOCLAW_ENDPOINT_URL=http://host.openshell.internal:18080/v1

# ── Outlook (optional — recommended primary channel) ─────────────────────
# Outlook is opt-in: fill ALL FOUR OUTLOOK_* vars below to enable, or leave
# the entire block empty for a Slack-only setup. Partial configuration is
# rejected at bring-up. At least one of Outlook or Slack must be configured.
#
# Tenant + client IDs come from your Azure app registration. First bring-up
# runs an interactive device-code login (see docs/set-up-outlook-bridge.md)
# and caches the refresh token to .bootstrap/cache/ms-graph-token.json.
# Optional flags: OUTLOOK_FORCE_LOGIN=1 (redo login), OUTLOOK_NO_CACHE=1
# (device-code on every bring-up, no on-disk cache).
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=

# Mailbox the agent reads/sends from, and the From: address it uses on replies.
# Example values: agent@yourcompany.com / you@yourcompany.com
OUTLOOK_TARGET_MAILBOX=
OUTLOOK_REPLY_TO=

# Optional: comma-separated allowlist of senders the agent will respond to.
# Leave empty to accept any sender.
OUTLOOK_ALLOWED_SENDERS=

# ── Slack ────────────────────────────────────────────────────────────────
# Both tokens are required to enable the Slack channel. SLACK_ALLOWED_IDS
# is an optional comma-separated allowlist of Slack user IDs (e.g.
# UR0A4QL5N) that can DM the agent; empty means anyone in the workspace.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_IDS=

# ── GitHub (live read-only REST) ─────────────────────────────────────────
# The sandbox uses this token through an OpenShell provider placeholder for
# live GitHub REST reads. The raw token is resolved by the proxy on egress,
# and policy.yaml constrains usage to read-only api.github.com routes for
# GITHUB_READONLY_REPO. If you also keep the host-side GitHub mirror enabled,
# GITHUB_TOKEN gives that ETL practical API rate limits.
GITHUB_TOKEN=
# Optional fallback for the live sandbox provider if GITHUB_TOKEN is empty.
# Prefer GITHUB_TOKEN when you also want the host GitHub mirror authenticated.
GH_TOKEN=

# Live sandbox GitHub read-only scope (owner/repo). Sandbox-create reads
# this from .env; recreate the sandbox after changing it:
#   bash scripts/tear-down.sh && bash scripts/bring-up.sh
GITHUB_READONLY_REPO=NVIDIA/OpenShell

# Optional host-side GitHub mirror repo for source-etls. This controls mirrored
# discussions/history in Postgres only; it does not change live sandbox access.
# SOURCE_ETL_GITHUB_REPO=NVIDIA/NemoClaw

# ── Optional: Telegram / Discord ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# DISCORD_BOT_TOKEN=

# ── Optional: Phoenix OpenInference egress ───────────────────────────────
# Set PHOENIX_COLLECTOR_ENDPOINT to stream OpenInference traces to a
# Phoenix collector for live inspection. 00-host-services.sh already runs
# Phoenix on host port 6006; the URL below routes the sandbox through the
# OpenShell host bridge to it.
# PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces

# Phoenix project name (openinference.project.name on each span). Defaults
# to "default"; override to keep deployments separate in one Phoenix.
# PHOENIX_PROJECT_NAME=personal-community-sentiment-triage

# ── Optional: ATIF trace export ──────────────────────────────────────────
# Completed agent trajectories (ATIF) can be written to the sandbox's local
# /tmp/atif (the default) or uploaded to S3-compatible object storage via
# the host-side `atif-export-relay` service (see extras/atif-export-relay/).
# In remote mode, the sandbox authenticates to the relay with a per-VM
# bearer token (carried via OpenShell's L7 placeholder substitution); the
# relay holds the real downstream credentials. Real AWS/MinIO credentials
# never enter the sandbox.
#
# Backend selector — picks where ATIF traces land AND which host-services
# compose profile is activated by scripts/00-host-services.sh.
#   local: traces stay in the sandbox at /tmp/atif (no host services).
#          Recoverable via scripts/download-traces.sh. This is the default
#          when the var is unset.
#   minio: local MinIO container (development / testing; no AWS infra needed).
#   s3:    real AWS S3 (production; requires the host's EC2 instance profile
#          to have s3:PutObject on the target bucket).
# ATIF_STORAGE_BACKEND=local
#
# Bucket the relay accepts uploads to (relay-side allowlist). For MinIO,
# this bucket is created by 00-host-services.sh; for S3, the infra team
# provisions it ahead of time. Ignored when backend=local.
# ATIF_STORAGE_BUCKET=nemo-relay-traces
#
# Key prefix appended inside the bucket. NeMo-Relay's S3 plugin uses this
# as the prefix portion of every uploaded object key. Defaults to hermes/.
# ATIF_STORAGE_KEY_PREFIX=hermes/
#
# AWS region — only consulted when backend=s3. Should match the bucket's
# region. Defaults to us-west-2 if unset.
# ATIF_S3_REGION=us-west-2
#
# Per-VM bearer token used to authenticate to atif-export-relay. Generated
# by scripts/02-providers.sh on first bring-up; reused on subsequent ones.
# Delete the line to force re-issuance.
# ATIF_RELAY_AUTH_TOKEN=
#
# HTTP header the relay reads the bearer from. Default matches the AWS-SDK
# client today; flip to "Authorization" or similar if you wire a non-S3-SDK
# client into the relay.
# ATIF_RELAY_AUTH_HEADER=X-Amz-Security-Token

# ── Optional: bring-up overrides ─────────────────────────────────────────
# SANDBOX_NAME=hermes-direct
#
# Gateway registration. Default (`openshell`) targets the package-managed
# install at https://127.0.0.1:17670. For snap installs, uncomment both
# lines (see deploy/snap/README.md):
# OPENSHELL_GATEWAY=openshell
# OPENSHELL_GATEWAY=snap-docker
# OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:17670
#
# SOURCE_ETL_API_HOST=host.openshell.internal
# SOURCE_ETL_API_PORT=3100
