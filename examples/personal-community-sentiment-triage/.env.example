# Copy to .env and fill in real values, then:
#   bash scripts/00-host-services.sh   # phoenix, postgres, ETLs, postgrest (+ minio + relay when ATIF_STORAGE_BACKEND=minio)
#   bash scripts/bring-up.sh           # OpenShell gateway, v2 providers, sandbox
#
# Both scripts auto-source .env, so `cp .env.example .env` and run is enough.
# Prereq: `openshell settings set --global --key providers_v2_enabled --value true --yes` (02-providers.sh enforces this and prints the command if missing).

# ── Inference (the agent's LLM) ──────────────────────────────────────────
# At least one API key is required for the agent to call any LLM. If both
# are unset, bring-up.sh skips the inference provider and warns.
# COMPATIBLE_API_KEY is preferred; OPENAI_API_KEY is also accepted.
#
# For the default NemoClaw endpoint, get a key from https://build.nvidia.com:
# sign in, open any model page, and click "Get API Key". The key may start
# with `nvapi-` or `sk-` depending on the backend.
COMPATIBLE_API_KEY=
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Optional override for the inference endpoint (default
# https://integrate.api.nvidia.com/v1). Any OpenAI-compatible URL works
# — local vLLM, alternative NIM, or scripts/host-tls-proxy.py for
# corporate VPNs (see docs/host-tls-proxy.md).
# NEMOCLAW_ENDPOINT_URL=http://host.openshell.internal:18080/v1

# ── Outlook (optional — recommended primary channel) ─────────────────────
# Outlook is opt-in: fill ALL FOUR OUTLOOK_* vars below to enable, or leave
# the entire block empty for a Slack-only setup. Partial configuration is
# rejected at bring-up. At least one of Outlook or Slack must be configured.
#
# Tenant + client IDs come from your Azure app registration. First bring-up
# runs an interactive device-code login (see docs/set-up-outlook-bridge.md)
# and caches the refresh token to .bootstrap/cache/ms-graph-token.json
# (mode 0600). Subsequent bring-ups reuse the cache if it's still fresh,
# auto-refreshing on staleness (~90 days for Microsoft Graph refresh tokens).
#
# Cache control (default: 1):
#   OUTLOOK_LOGIN_CACHE=0   — off (device-code login every bring-up, nothing on disk).
#   OUTLOOK_LOGIN_CACHE=1   — use cache, auto-refresh on staleness.   [default]
#   OUTLOOK_LOGIN_CACHE=2   — force device-code login and rewrite the cache.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=

# Mailbox the agent reads/sends from, and the From: address it uses on replies.
# Example values: agent@yourcompany.com / you@yourcompany.com
OUTLOOK_TARGET_MAILBOX=
OUTLOOK_REPLY_TO=

# Optional: comma-separated allowlist of senders the agent will respond to.
# Leave empty to accept any sender.
OUTLOOK_ALLOWED_SENDERS=

# ── Slack ────────────────────────────────────────────────────────────────
# Both tokens are required to enable the Slack channel. SLACK_ALLOWED_IDS
# is an optional comma-separated allowlist of Slack user IDs (e.g.
# UR0A4QL5N) that can DM the agent; empty means anyone in the workspace.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_IDS=

# ── GitHub (live read-only REST) ─────────────────────────────────────────
# The sandbox uses this token through an OpenShell provider placeholder for
# live GitHub REST reads. The raw token is resolved by the proxy on egress,
# and policy.yaml constrains usage to read-only api.github.com routes for
# GITHUB_READONLY_REPO. If you also keep the host-side GitHub mirror enabled,
# GITHUB_TOKEN gives that ETL practical API rate limits.
GITHUB_TOKEN=
# Optional fallback for the live sandbox provider if GITHUB_TOKEN is empty.
# Prefer GITHUB_TOKEN when you also want the host GitHub mirror authenticated.
GH_TOKEN=

# Live sandbox GitHub read-only scope (owner/repo). Sandbox-create reads
# this from .env; recreate the sandbox after changing it:
#   bash scripts/tear-down.sh && bash scripts/bring-up.sh
GITHUB_READONLY_REPO=NVIDIA/OpenShell

# Optional host-side GitHub mirror repo for source-etls. This controls mirrored
# discussions/history in Postgres only; it does not change live sandbox access.
# SOURCE_ETL_GITHUB_REPO=NVIDIA/NemoClaw

# ── Optional: Telegram / Discord ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# DISCORD_BOT_TOKEN=

# ── Optional: Phoenix OpenInference egress ───────────────────────────────
# Set PHOENIX_COLLECTOR_ENDPOINT to stream OpenInference traces to a
# Phoenix collector for live inspection. 00-host-services.sh already runs
# Phoenix on host port 6006; the URL below routes the sandbox through the
# OpenShell host bridge to it.
# PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces

# Phoenix project name (openinference.project.name on each span). Defaults
# to "default"; override to keep deployments separate in one Phoenix.
# PHOENIX_PROJECT_NAME=personal-community-sentiment-triage

# ── Optional: ATIF trace export ──────────────────────────────────────────
# Completed agent trajectories (ATIF) can be written to the sandbox's local
# /tmp/atif (the default) or uploaded to S3-compatible object storage via
# the host-side `atif-export-relay` service (see extras/atif-export-relay/).
# In remote mode, the sandbox authenticates to the relay with a per-VM
# bearer token (carried via OpenShell's L7 placeholder substitution); the
# relay holds the real downstream credentials. Real AWS/MinIO credentials
# never enter the sandbox.
#
# The relay is the SOLE owner of the downstream bucket, the object-key prefix,
# AND the credentials. The sandbox image bakes none of these — it sends a
# vestigial placeholder bucket + bare keys; the relay rewrites them at egress.
# So the values below are set on the HOST (read by the relay container), not
# baked into the sandbox.
#
# Export mode (deployment-wide switch — gates the sandbox bake, host services,
# and providers; NOT a relay knob):
#   local: traces stay in the sandbox at /tmp/atif (no host services).
#          Recoverable via scripts/download-traces.sh. Default when unset.
#   relay: traces go through the host-side atif-export-relay. Requires
#          ATIF_RELAY_BACKEND below; bring-up errors loudly if it's unset.
# ATIF_EXPORT_MODE=local
#
# Relay downstream (only consulted when ATIF_EXPORT_MODE=relay):
#   minio:         local MinIO container (development / testing; no AWS infra).
#   s3:            real AWS S3 (production; host EC2 instance profile needs
#                  s3:PutObject — and kms:GenerateDataKey if the bucket uses
#                  SSE-KMS — on the target bucket/prefix). Creds via IMDS.
#   s3-compatible: any external S3-compatible store reached via an explicit
#                  endpoint + static/HMAC creds — OCI Object Storage (S3 Compat),
#                  Nebius, GCS XML/interop, self-hosted. Set ATIF_RELAY_S3_*
#                  below. (Azure Blob is NOT S3-compatible — it would need a
#                  dedicated backend; see docs/atif-export.md.)
# ATIF_RELAY_BACKEND=s3
#
# The downstream bucket the relay writes EVERY object to (the sandbox cannot
# influence it). For MinIO this bucket is created by 00-host-services.sh; for
# s3 / s3-compatible the infra team provisions it. Defaults to nemo-relay-traces
# (the MinIO dev bucket) if unset.
# ATIF_RELAY_BUCKET=nemo-relay-traces
#
# AWS region — consulted for backend=s3 (and as the signing region for
# s3-compatible). Should match the bucket's region. Defaults to us-west-2.
# (Relay-owned; the sandbox's vestigial signing region is a fixed placeholder.)
# ATIF_RELAY_S3_REGION=us-west-2
#
# Endpoint + static creds for the custom-endpoint backends — used by BOTH
# `minio` and `s3-compatible` (AWS `s3` uses IMDS, not these):
#   - backend=minio: optional. Empty → local-dev defaults http://localhost:9000
#     + minioadmin/minioadmin (zero-config). NOTE: the relay no longer derives
#     these from the container's NEMOCLAW_MINIO_* admin vars, so if you customize
#     those, set ATIF_RELAY_S3_ACCESS_KEY/SECRET_KEY to match.
#   - backend=s3-compatible: REQUIRED (relay fails to start if unset). Example (OCI):
#       ATIF_RELAY_S3_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
#       ATIF_RELAY_S3_ACCESS_KEY=<customer-secret-key-access-id>
#       ATIF_RELAY_S3_SECRET_KEY=<customer-secret-key>
# A remote endpoint MUST be https:// (the relay refuses cleartext creds); http://
# is allowed only for loopback (local MinIO).
# ATIF_RELAY_S3_ENDPOINT=
# ATIF_RELAY_S3_ACCESS_KEY=
# ATIF_RELAY_S3_SECRET_KEY=
#
# ── Object-key prefix (relay-owned) ──────────────────────────────────────
# The relay composes every object key as:
#     <prefixer output> + ATIF_RELAY_KEY_PREFIX + <bare key from sandbox>
#
# ATIF_RELAY_PREFIXER selects HOW the dynamic leading segment is computed:
#   none            (default) no dynamic segment — prefix is just ATIF_RELAY_KEY_PREFIX.
#   ec2-instance-id resolve the EC2 instance-id via IMDSv2 at relay startup and
#                   prefix every key with "<instance-id>/". Use this when the
#                   bucket's IAM policy scopes s3:PutObject to
#                   arn:aws:s3:::<bucket>/<instance-id>/*. If IMDS can't be reached
#                   (e.g. not on EC2) the relay refuses to start (fail-loud).
# Add your own strategy (e.g. gcp-instance-id) in
# extras/atif-export-relay/backends/prefixers.py.
# ATIF_RELAY_PREFIXER=none
#
# ATIF_RELAY_KEY_PREFIX is an optional static segment after the prefixer output
# (include a trailing "/" if you want a separator). Examples:
#   prefixer=ec2-instance-id, ATIF_RELAY_KEY_PREFIX=          -> "<iid>/<key>"
#   prefixer=ec2-instance-id, ATIF_RELAY_KEY_PREFIX=hermes/   -> "<iid>/hermes/<key>"
#   prefixer=none,            ATIF_RELAY_KEY_PREFIX=hermes/   -> "hermes/<key>"  (e.g. MinIO dev)
# ATIF_RELAY_KEY_PREFIX=
#
# Per-VM bearer token used to authenticate to atif-export-relay. You normally
# leave this UNSET: bring-up auto-generates it into the gitignored
# .bootstrap/cache/atif-relay-token (not into .env) and reuses it. Rotate by
# deleting that file (+ .registered) and re-running bring-up. Set it here only
# to pin a specific value (overrides the cache).
# ATIF_RELAY_AUTH_TOKEN=
#
# HTTP header the relay reads the bearer from. Default matches the AWS-SDK
# client today; flip to "Authorization" or similar if you wire a non-S3-SDK
# client into the relay.
# ATIF_RELAY_AUTH_HEADER=X-Amz-Security-Token
#
# Public endpoint the sandbox-side bridge / OpenShell provider connects to.
# Single source of truth: the relay's bind port, the bridge upstream URL,
# the policy egress rule, the provider profile, and the TLS cert SAN are
# all derived from this. Change the host portion and the cert is
# regenerated on the next bring-up (ATIF_RELAY_FORCE_CERT=1 forces it).
# ATIF_RELAY_ENDPOINT=https://host.openshell.internal:18443

# ── Optional: bring-up overrides ─────────────────────────────────────────
# SANDBOX_NAME=hermes-direct
#
# Gateway registration. Default (`openshell`) targets the package-managed
# install at https://127.0.0.1:17670. For snap installs, uncomment both
# lines (see deploy/snap/README.md):
# OPENSHELL_GATEWAY=openshell
# OPENSHELL_GATEWAY=snap-docker
# OPENSHELL_GATEWAY_ENDPOINT=http://127.0.0.1:17670
#
# SOURCE_ETL_API_HOST=host.openshell.internal
# SOURCE_ETL_API_PORT=3100
