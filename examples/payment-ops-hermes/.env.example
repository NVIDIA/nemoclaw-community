# Copy to .env and fill in. Never commit .env.

# Inference provider for the Hermes sandbox (OpenAI-compatible).
COMPATIBLE_API_KEY=
NEMOCLAW_ENDPOINT_URL=https://integrate.api.nvidia.com/v1
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# Sandbox name used by the lifecycle scripts.
NEMOCLAW_SANDBOX_NAME=payment-ops

# NeMo Relay always writes ATIF locally when embedded in the custom Hermes
# image. Set the collector to also export OpenInference spans to Phoenix.
PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces
NEMO_RELAY_PROJECT_NAME=finguard-payment-ops

# Package-managed OpenShell defaults. Snap users should change both values.
OPENSHELL_GATEWAY=openshell
OPENSHELL_GATEWAY_ENDPOINT=https://127.0.0.1:17670

# OFAC SDN export used by scripts/refresh_ofac_snapshot.py (optional override)
# OFAC_SDN_CSV_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
