# Required model route. These values are read by scripts/demo.sh; the file is
# never sourced wholesale and secrets are never sent to the browser.
FINANCE_API_URL=https://integrate.api.nvidia.com/v1
FINANCE_API_KEY=
FINANCE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Demo names and ports.
NEMOCLAW_SANDBOX_NAME=financial-analyst
FINANCE_UI_PORT=18080

# Optional SEC contact identity used by the company-facts helper.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional one-owner Outlook bridge. Only this sender/mailbox pair is allowed.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_TARGET_MAILBOX=
OUTLOOK_REPLY_TO=
OUTLOOK_LOGIN_CACHE=1
