# SPDX-License-Identifier: Apache-2.0
#
# Copy this file to .env and fill in the values you want to use:
#
#   cp .env.example .env
#   ${EDITOR:-vi} .env
#
# Do not commit .env. The repo ignores real .env files.

# ---------------------------------------------------------------------------
# Required for the model route
# ---------------------------------------------------------------------------

# Chat-completions compatible endpoint. Include /v1.
FINANCE_API_URL=https://integrate.api.nvidia.com/v1

# API key from build.nvidia.com. The UI server keeps this server-side; the
# browser never sees it.
FINANCE_API_KEY=

# Model sent in chat-completions requests.
FINANCE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional non-secret label returned by /config and shown in docs/health checks.
FINANCE_UPSTREAM_LABEL=Build API

# NemoHermes sandbox name used throughout the docs and scripts.
NEMOCLAW_SANDBOX_NAME=financial-analyst

# Optional alias used by OpenShell/NemoClaw commands. Most copy/paste docs
# export this after sourcing .env, so leaving it blank is fine.
NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Optional: SEC helper identity
# ---------------------------------------------------------------------------

# The SEC requests a descriptive user agent for programmatic API use.
SEC_USER_AGENT=Your Name your.email@example.com

# ---------------------------------------------------------------------------
# Optional: Phoenix + NeMo Relay
# ---------------------------------------------------------------------------

# For Phoenix running on the Brev host, the sandbox reaches it through
# host.openshell.internal.
PHOENIX_COLLECTOR_ENDPOINT=http://host.openshell.internal:6006/v1/traces
PHOENIX_PROJECT_NAME=financial-assistant-relay

# The UI server reads recent Phoenix spans through GraphQL on the host.
FINANCE_PHOENIX_GRAPHQL_URL=http://127.0.0.1:6006/graphql

# ---------------------------------------------------------------------------
# Optional: Outlook one-owner bridge
# ---------------------------------------------------------------------------

# The bridge reads only OUTLOOK_TARGET_MAILBOX, processes only OUTLOOK_REPLY_TO,
# and replies only in-thread.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_TARGET_MAILBOX=
OUTLOOK_REPLY_TO=
OUTLOOK_ALLOWED_SENDERS=

# 1 = reuse cache, 0 = never write cache, 2 = force a fresh device-code login.
OUTLOOK_LOGIN_CACHE=1
